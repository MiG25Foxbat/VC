# Скопируй в .env и заполни. .env в git не попадает.

LLM_PROVIDER=google            # google | cerebras | groq | openrouter
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# DaData. Только бесплатные методы на suggestions.dadata.ru
DADATA_TOKEN=

# SuperJob. Заголовок X-Api-App-Id
SUPERJOB_APP_ID=

# Телеграм. Нужно только если подключаешь каналы как источник
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

CACHE_TTL_SECONDS=604800        # 7 суток, жёсткий потолок
HTTP_TIMEOUT_SECONDS=15
MAX_CONCURRENT_SOURCES=6
